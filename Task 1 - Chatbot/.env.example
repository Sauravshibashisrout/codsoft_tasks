# Copy this file to .env and fill in your values.

# MongoDB connection. Defaults to a local instance if unset.
# For MongoDB Atlas (free tier, no local install):
#   https://www.mongodb.com/atlas  -> create free cluster -> get connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=chatbot

# Optional — enables the LLM fallback for messages that don't match any rule.
# Free, no credit card required: https://console.groq.com/keys
# The chatbot works fully in rule-based mode without this key.
GROQ_API_KEY=
